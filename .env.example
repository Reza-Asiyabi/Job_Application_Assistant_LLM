# OpenAI API key — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: override the default OpenAI API endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Path to your CV PDF file (default: cv.pdf)
CV_PATH=cv.pdf

# Optional: paths to your profile files. Point PROFILE_PERSONAL_PATH at a
# private copy (e.g. My_Profile.md) so your personal data stays out of git.
# Defaults: profile_personal.md / profile_instructions.md / profile.md (legacy)
# PROFILE_PERSONAL_PATH=My_Profile.md
# PROFILE_INSTRUCTIONS_PATH=profile_instructions.md
# PROFILE_PATH=profile.md
